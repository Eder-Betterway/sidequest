# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project Settings > Environment Variables.

# Claude API (server only). Create at console.anthropic.com with a monthly spend limit.
ANTHROPIC_API_KEY=

# Firebase web app config (safe to expose; security rules do the protecting).
# Production uses the real project, Preview uses the test project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated emails allowed to use the AI routes (server only).
ALLOWED_EMAILS=

# Optional data sources (server only). Features that need them show a fallback when unset.
GOOGLE_PLACES_API_KEY=
ORS_API_KEY=
NPS_API_KEY=
RIDB_API_KEY=

# Tests only: serve saved AI responses instead of calling Claude.
# AI_MOCK=1
